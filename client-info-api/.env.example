# Writable application-state database for AI settings, summaries, Binotel monitor,
# local notes, and recording-cache metadata. Keep DB_* above for read-only CRM data.
APP_STATE_DB_ENABLED=true
APP_STATE_DB_HOST=127.0.0.1
APP_STATE_DB_PORT=5432
APP_STATE_DB_NAME=client_info_api
APP_STATE_DB_USER=postgres
APP_STATE_DB_PASSWORD=change-me
APP_STATE_DB_SSL=false
APP_STATE_DB_POOL_MAX=10
APP_STATE_DB_CONNECT_TIMEOUT_MS=5000

AUTH_SESSION_SECRET=change-me-random-session-secret
AUTH_SEED_ADMINS=admin:change-me-password
AUTH_SESSION_TTL_MS=28800000
AUTH_COOKIE_SECURE=false
AUTH_PBKDF2_ITERATIONS=210000
AUTH_MIN_PASSWORD_LENGTH=8

